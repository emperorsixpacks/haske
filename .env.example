# Example environment. Copy to .env and fill in real values, or leave unset for MOCK mode.

# Meta Model API (OpenAI-compatible). Leave META_API_KEY unset to run in MOCK mode.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_VISION_MODEL=muse-spark-1.3

# Optional: fully override registry data sources for local dev.
HASKE_DATA_DIR=api/data

# Optional: route the NAPAMS Playwright browser through a proxy (bypasses
# datacenter reCAPTCHA). Leave unset for a direct connection.
# NAPAMS_PROXY_URL=http://127.0.0.1:8080
# NAPAMS_PROXY_USERNAME=
# NAPAMS_PROXY_PASSWORD=
